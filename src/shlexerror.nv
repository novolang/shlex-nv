// shlexerror.nv — the three ways a line is not finished, and the one
// way it is not POSIX.
//
// AN UNFINISHED LINE IS NOT A BROKEN LINE
//
// A line ending inside a quote and a line ending with a backslash are
// both incomplete: a shell reading interactively would print its
// secondary prompt and read more.  A line holding `$'a b'` is
// something else — it is finished, and it means one thing to bash and
// another to a POSIX shell.
//
// `is_incomplete` is the function that separates them, and it is the
// whole reason this enum is not three arms.  A terminal reading a
// command from a user continues on the first and refuses on the
// second.  A configuration reader refuses on both and says different
// things.

use shlexbash

// Why a line could not be split, or a word could not be quoted.
//
// ```novo
// use shlexerror
//
// fn main() [io]
//     println(ShlexUnterminatedSingle(4).message())
// ```
pub enum ShlexFault
    // A single quote was opened and never closed.  `at` is the offset
    // of the opening quote.  INCOMPLETE: there is no escape inside a
    // single-quoted string, so the rest of the line, whatever it
    // holds, is part of the word until the next `'`.
    ShlexUnterminatedSingle(at: Int)
    // A double quote was opened and never closed.  `at` is the offset
    // of the opening quote.  INCOMPLETE.
    ShlexUnterminatedDouble(at: Int)
    // The line ends with a backslash that escapes nothing.  `at` is
    // its offset.  INCOMPLETE: in a shell this is a line continuation
    // and the next line belongs to the same command.
    ShlexDanglingEscape(at: Int)
    // The line holds a construct bash splits differently from the
    // Shell Command Language.  NOT incomplete: reading more would not
    // help, because the disagreement is about the line that is already
    // there.
    ShlexBashOnly(form: shlexbash.ShlexBashForm, at: Int)
    // A word handed to the quoter holds a NUL byte.  No shell can
    // carry one in an argument, there is no quoting that admits it,
    // and a quoter that dropped it would produce a command line that
    // is not the one it was asked for.  `at` is its offset.
    ShlexNulByte(at: Int)

// `ShlexFault` is an `Error`, which is what lets
// `Result<T, ShlexFault>` exist at all (SPEC section 3.4).
impl Error for ShlexFault
    // The one-line message, naming the construct and its offset.
    //
    // Panics with `not implemented` until the bodies land.
    fn message(self) -> Str
        todo("shlex-nv.ShlexFault.message")

// Whether the line would be finished by reading more of it.
//
// True for the three unfinished forms and false for the other two.  An
// interactive reader continues; a reader of a finished string refuses.
//
// ```novo
// use shlexerror
//
// fn main() [io]
//     println("${shlexerror.is_incomplete(ShlexUnterminatedDouble(0))}")
//     println("${shlexerror.is_incomplete(ShlexNulByte(3))}")
// ```
pub fn is_incomplete(f: ShlexFault) -> Bool []
    todo("shlex-nv.shlexerror.is_incomplete")

// The byte offset the fault is about.
//
// Every arm has one, because every one of them is about a character
// somewhere in the input.  A caller pointing a caret at a line needs
// it and never has to ask whether this fault has a position.
//
// ```novo
// use shlexerror
//
// fn main() [io]
//     println("${shlexerror.offset(ShlexDanglingEscape(11))}")
// ```
pub fn offset(f: ShlexFault) -> Int []
    todo("shlex-nv.shlexerror.offset")

// A short stable code for a log or a metric label:
// `"unterminated_single"`, `"bash_only"`, and the rest.
//
// Free of anything the line carried, so it is safe as a metric label.
//
// ```novo
// use shlexerror
//
// fn main() [io]
//     println(shlexerror.code(ShlexUnterminatedSingle(4)))
// ```
pub fn code(f: ShlexFault) -> Str []
    todo("shlex-nv.shlexerror.code")

// The character a shell would be waiting for, or `""`.
//
// `"'"` for an unterminated single quote, `"\""` for a double one,
// `"\\"` for a dangling backslash, and empty for the two faults that
// reading more would not fix.  A terminal that shows what it is
// waiting for in its secondary prompt has exactly this string.
//
// ```novo
// use shlexerror
//
// fn main() [io]
//     println(shlexerror.waiting_for(ShlexUnterminatedSingle(4)))
// ```
pub fn waiting_for(f: ShlexFault) -> Str []
    todo("shlex-nv.shlexerror.waiting_for")
