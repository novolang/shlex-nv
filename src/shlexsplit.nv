// shlexsplit.nv — a command line into words, by the Shell Command
// Language's rules and no others.
//
// POSIX.1-2017, Shell Command Language, section 2.2 defines quoting
// with four characters, and section 2.3 delimits words with blanks:
//
//   \       the next character is literal.  At the end of a line it is
//           a line continuation and both characters disappear.
//   '...'   every character up to the next `'` is literal.  There is
//           no escape inside, so a single quote cannot appear in one.
//   "..."   every character up to the next `"` is literal, except that
//           a backslash still escapes `$`, a backtick, `"`, `\` and a
//           newline.
//   #       when it begins a word, the rest of the line is a comment.
//
// The blanks are space, tab and newline, the default value of `IFS`.
// Everything else is an ordinary character, including `$`, a backtick,
// `~`, `*` and `?`.
//
// A shell splits a line into words and then expands them: it
// substitutes parameters, runs command substitutions, and expands a
// tilde into a home directory and a glob into file names.  Each of
// those reads the environment, a process or a directory, and this
// module reads nothing.  So `echo $HOME` splits into `echo` and
// `$HOME`, which is what a POSIX shell's splitting produces before its
// expansion step.  `would_expand` tells a caller whether a word would
// mean more to a shell than it means here.

use shlexbash
use shlexerror

// One word, with where it came from.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     match shlexsplit.words("echo hi", shlexsplit.options())
//         Ok(found)  => println(found[0].text)
//         Err(fault) => println(fault.message())
// ```
pub struct ShlexWord
    // The word with its quoting removed: what a shell would pass as
    // one argument, before any expansion.
    text: Str
    // The byte offset in the line where the word starts, including its
    // opening quote.
    start: Int
    // The byte offset just past where it ends, including its closing
    // quote.  An editor highlighting the word a cursor is in needs
    // both.
    end: Int
    // Whether any part of the word was quoted or escaped.  A quoted
    // part is one a shell would not have expanded, which is how a
    // caller tells a glob from a file called `*`.
    quoted: Bool

// What the splitter treats as a comment.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     println("${shlexsplit.options().comments}")
// ```
pub struct ShlexOptions
    // Whether a `#` beginning a word starts a comment that runs to the
    // next newline.  Off by default: a command line typed at a prompt
    // has no comments, and a `#` in it is usually a character in a file
    // name.  A configuration file that holds command lines turns it on.
    comments: Bool

// The defaults: no comments.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     println("${shlexsplit.options().comments}")
// ```
pub fn options() -> ShlexOptions []
    ShlexOptions { comments: false }

// The same options with `#` starting a comment.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     println("${shlexsplit.with_comments(shlexsplit.options()).comments}")
// ```
pub fn with_comments(o: ShlexOptions) -> ShlexOptions []
    ShlexOptions { comments: true }

// A line into words, quoting removed.
//
// The call almost every caller wants.  A line that ends inside a quote
// or with a dangling backslash is refused as incomplete.  A finished
// line holding a bash-only form is refused rather than split by the
// wrong rules, as `shlexbash` describes.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     match shlexsplit.split("cp -r 'my files' /tmp")
//         Ok(argv)   => println("${list.len(argv)} word(s)")
//         Err(fault) => println(fault.message())
// ```
pub fn split(line: Str) -> Result<[Str], shlexerror.ShlexFault> []
    split_with(line, options())

// The same, under options.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     let o = shlexsplit.with_comments(shlexsplit.options())
//     match shlexsplit.split_with("ls -l  # a comment", o)
//         Ok(argv)   => println("${list.len(argv)} word(s)")
//         Err(fault) => println(fault.message())
// ```
pub fn split_with(line: Str, o: ShlexOptions) -> Result<[Str], shlexerror.ShlexFault> []
    let found = words(line, o)!
    var texts: [Str] = []
    for w in found
        list.push(texts, w.text)
    Ok(texts)

// The words with their offsets and whether each was quoted.
//
// What `split` answers, plus everything an editor or a diagnostic
// needs: where to put a caret, which word a cursor is in, and whether
// the user wrote quotes.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     match shlexsplit.words("cp 'a b' c", shlexsplit.options())
//         Ok(found)  => println("${found[1].start}")
//         Err(fault) => println(fault.message())
// ```
pub fn words(line: Str, o: ShlexOptions) -> Result<[ShlexWord], shlexerror.ShlexFault> []
    let found = scan(line, o.comments, 0)!
    match shlexbash.scan(line, o.comments)
        Some(bash) => Err(ShlexBashOnly(bash.form, bash.at))
        None       => Ok(found)

// Whether a line is finished, so that splitting it would not answer an
// incomplete fault.
//
// The question a terminal asks before it decides whether to print its
// secondary prompt.  A line ending inside a quote or with a dangling
// backslash is not finished; a line holding a bash-only form is
// finished and will still be refused, which is why this is not the
// same as "will split succeed".
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     println("${shlexsplit.is_complete("echo 'hi")}")
//     println("${shlexsplit.is_complete("echo hi")}")
// ```
pub fn is_complete(line: Str) -> Bool []
    match scan(line, false, 0)
        Ok(_)      => true
        Err(fault) => not shlexerror.is_incomplete(fault)

// The first word of a line, or `None` when it has none.
//
// The program name, without splitting the rest.  A launcher deciding
// which handler to use, and a history search, both stop here.  `None`
// also answers a line whose first word is unfinished or holds a
// bash-only form, since that word is not known.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     match shlexsplit.first_word("git commit -m 'a message'")
//         Some(program) => println(program)
//         None          => println("an empty line")
// ```
pub fn first_word(line: Str) -> ?Str []
    match scan(line, false, 1)
        Ok(found) => first_if_posix(line, found)
        Err(_)    => None

// Whether a word would mean more to a shell than it means here.
//
// The word is read as a shell would read it in a command line, quotes
// included.  True when it begins with an unquoted `~`, holds an
// unquoted `*`, `?` or `[`, or holds a `$` or a backtick outside single
// quotes, since a shell expands those inside double quotes too.  A
// shell expands each of them after the splitting this package does.
//
// A caller building a command line for `sh -c` uses
// `shlexquote.quote` and does not need to ask.  A caller holding a word
// from somewhere else asks this to learn whether it is inert.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     println("${shlexsplit.would_expand("*.txt")}")
//     println("${shlexsplit.would_expand("/home/ada")}")
// ```
pub fn would_expand(word: Str) -> Bool []
    if str.byte_at_or(word, 0, 0) == '~'
        return true
    let n = str.len(word)
    var i = 0
    for _ in 0..n
        if i >= n
            break
        let c = str.byte_at_or(word, i, 0)
        if c == '$' or c == '`' or c == '*' or c == '?' or c == '['
            return true
        if c == '\\'
            i = i + 2
        else if c == '\''
            i = (str.index_from(word, "'", i + 1) ?? n) + 1
        else if c == '"'
            if double_expands(word, i)
                return true
            i = double_close(word, i)
        else
            i = i + 1
    false

// Where a comment begins in a line, or `-1`.
//
// The offset of the first `#` that begins a word, found under the same
// rules the splitter uses, so a `#` inside quotes or in the middle of a
// word is not one.  A configuration reader that keeps the comment
// rather than dropping it needs the position.
//
// ```novo
// use shlexsplit
//
// fn main() [io]
//     println("${shlexsplit.comment_at("ls -l # why")}")
//     println("${shlexsplit.comment_at("grep '#' file")}")
// ```
pub fn comment_at(line: Str) -> Int []
    let n = str.len(line)
    var i = 0
    var word_start = true
    for _ in 0..n
        if i >= n
            break
        let c = str.byte_at_or(line, i, 0)
        if is_blank(c)
            word_start = true
            i = i + 1
        else if c == '\\' and str.byte_at_or(line, i + 1, 0) == '\n'
            i = i + 2
        else if c == '#' and word_start
            return i
        else
            word_start = false
            if c == '\\'
                i = i + 2
            else if c == '\''
                i = (str.index_from(line, "'", i + 1) ?? n) + 1
            else if c == '"'
                i = double_close(line, i)
            else
                i = i + 1
    0 - 1

fn is_blank(c: Int) -> Bool
    c == ' ' or c == '\t' or c == '\n'

// The words of `line`, stopping after `limit` of them when `limit` is
// above zero.  Quoting is removed and nothing is checked for bash-only
// forms.
fn scan(line: Str, comments: Bool, limit: Int) -> Result<[ShlexWord], shlexerror.ShlexFault>
    let n = str.len(line)
    var found: [ShlexWord] = []
    var i = 0
    var in_word = false
    var start = 0
    var text = ""
    var quoted = false
    for _ in 0..n
        if i >= n
            break
        let c = str.byte_at_or(line, i, 0)
        let d = str.byte_at_or(line, i + 1, 0)
        if not in_word
            if is_blank(c)
                i = i + 1
                continue
            if c == '\\' and d == '\n'
                i = i + 2
                continue
            if comments and c == '#'
                i = str.index_from(line, "\n", i) ?? n
                continue
            in_word = true
            start = i
            text = ""
            quoted = false
        if is_blank(c)
            list.push(found, ShlexWord { text: text, start: start, end: i, quoted: quoted })
            in_word = false
            if limit > 0 and list.len(found) >= limit
                return Ok(found)
            i = i + 1
        else if c == '\\'
            if i + 1 >= n
                return Err(ShlexDanglingEscape(i))
            if d != '\n'
                text = text + str.slice(line, i + 1, i + 2)
                quoted = true
            i = i + 2
        else if c == '\''
            let close = str.index_from(line, "'", i + 1) ?? 0 - 1
            if close < 0
                return Err(ShlexUnterminatedSingle(i))
            text = text + str.slice(line, i + 1, close)
            quoted = true
            i = close + 1
        else if c == '"'
            let (body, next) = double_body(line, i)!
            text = text + body
            quoted = true
            i = next
        else
            let run = ordinary_end(line, i)
            text = text + str.slice(line, i, run)
            i = run
    if in_word
        list.push(found, ShlexWord { text: text, start: start, end: n, quoted: quoted })
    Ok(found)

// The offset of the first byte at or after `i` that is a blank or one
// of the three quoting characters.
fn ordinary_end(line: Str, i: Int) -> Int
    let n = str.len(line)
    for j in i..n
        let c = str.byte_at_or(line, j, 0)
        if is_blank(c) or c == '\\' or c == '\'' or c == '"'
            return j
    n

// The text of the double-quoted string opening at `open`, with its
// escapes removed, and the offset just past its closing quote.
//
// Inside double quotes a backslash escapes only `$`, a backtick, `"`,
// `\` and a newline, and before a newline both characters disappear
// (section 2.2.3).  Before anything else the backslash is kept.
fn double_body(line: Str, open: Int) -> Result<(Str, Int), shlexerror.ShlexFault>
    let n = str.len(line)
    var text = ""
    var run = open + 1
    var i = open + 1
    for _ in 0..n
        if i >= n
            break
        let c = str.byte_at_or(line, i, 0)
        if c == '"'
            return Ok((text + str.slice(line, run, i), i + 1))
        if c == '\\'
            let d = str.byte_at_or(line, i + 1, 0)
            if d == '\n'
                text = text + str.slice(line, run, i)
                i = i + 2
                run = i
                continue
            if d == '$' or d == '`' or d == '"' or d == '\\'
                text = text + str.slice(line, run, i) + str.slice(line, i + 1, i + 2)
                i = i + 2
                run = i
                continue
        i = i + 1
    Err(ShlexUnterminatedDouble(open))

// The offset just past the double-quoted string opening at `open`, or
// the length of `line` when it is never closed.
fn double_close(line: Str, open: Int) -> Int
    match double_body(line, open)
        Ok((_, next)) => next
        Err(_)        => str.len(line)

// Whether the double-quoted string opening at `open` holds a `$` or a
// backtick that no backslash escapes.
fn double_expands(line: Str, open: Int) -> Bool
    let end = double_close(line, open)
    var i = open + 1
    for _ in 0..end
        if i >= end
            break
        let c = str.byte_at_or(line, i, 0)
        if c == '$' or c == '`'
            return true
        if c == '\\'
            i = i + 2
        else
            i = i + 1
    false

// The first of `found` as the line's first word, unless it is empty or
// a bash-only form starts before that word ends.
fn first_if_posix(line: Str, found: [ShlexWord]) -> ?Str
    if list.len(found) == 0
        return None
    let first = found[0]
    let bash_at = match shlexbash.scan(line, false)
        Some(bash) => bash.at
        None       => str.len(line)
    if bash_at < first.end
        return None
    Some(first.text)
