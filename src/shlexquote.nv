// shlexquote.nv — a word a shell reads back as the word it was.
//
// A word that needs quoting is wrapped in single quotes, and every
// single quote inside it is written `'\''`: close the string, an
// escaped quote, open it again.  Inside a single-quoted string the
// Shell Command Language gives no character a special meaning
// (section 2.2.2), so nothing else needs escaping and no list of
// metacharacters has to be kept up to date.  Python's `shlex.quote`
// uses the same strategy and writes the inner quote as `'"'"'`.
//
// A word needs no quoting when every byte is an ASCII letter, a digit,
// or one of `@%+=:,./-_`.  That is Python's set.  Every other byte,
// including every byte of a multi-byte character, is quoted.
//
// Quoting makes a string one word.  It does not make that word
// harmless: `quote("-rf")` is `-rf`, which still means `-rf` to the
// program receiving it.  `is_option_like` says so, and the caller
// prefixes `./` or puts `--` before the operands.

use shlexerror

// A word a shell will read back unchanged.
//
// Returned as it stands when nothing in it needs quoting, so an
// ordinary command line stays readable.  An empty string becomes
// `''`, because nothing is not a word.
//
// A NUL byte is refused: no shell can carry one in an argument, and
// dropping it would produce a command line other than the one that was
// asked for.
//
// ```novo
// use shlexquote
//
// fn main() [io]
//     match shlexquote.quote("my files")
//         Ok(word)   => println(word)
//         Err(fault) => println(fault.message())
// ```
pub fn quote(word: Str) -> Result<Str, shlexerror.ShlexFault> []
    let nul = first_nul(word)
    if nul >= 0
        return Err(ShlexNulByte(nul))
    if not needs_quoting(word)
        return Ok(word)
    Ok("'" + str.replace(word, "'", "'\\''") + "'")

// The same word, appended to a buffer the caller owns, answering the
// number of bytes appended.
//
// For a caller assembling a long command line in one buffer.  A word
// that is refused appends nothing.
//
// ```novo
// use shlexquote
//
// fn main() [io]
//     var buffer: [u8] = []
//     match shlexquote.quote_into(buffer, "my files")
//         Ok(added)  => println("${added} byte(s), ${list.len(buffer)} in the buffer")
//         Err(fault) => println(fault.message())
// ```
pub fn quote_into(var out: [u8], word: Str) -> Result<Int, shlexerror.ShlexFault> []
    let quoted = quote(word)!
    let n = str.len(quoted)
    for i in 0..n
        list.push(out, str.byte_at_or(quoted, i, 0))
    Ok(n)

// A command line from a list of words, each quoted, joined with single
// spaces.
//
// `shlexsplit.split(shlexquote.join(argv))` answers `argv` again, for
// every list of words that holds no NUL byte.  That round trip is what
// this function is for and what its tests assert.
//
// ```novo
// use shlexquote
//
// fn main() [io]
//     match shlexquote.join(["cp", "-r", "my files", "/tmp"])
//         Ok(line)   => println(line)
//         Err(fault) => println(fault.message())
// ```
pub fn join(words: [Str]) -> Result<Str, shlexerror.ShlexFault> []
    var quoted: [Str] = []
    for word in words
        list.push(quoted, quote(word)!)
    Ok(str.join(quoted, " "))

// Whether a word would change meaning if it were written into a
// command line as it stands.
//
// True for the empty string, which would vanish, and for a word holding
// any byte other than an ASCII letter, a digit or one of `@%+=:,./-_`.
// False for the words a shell passes through as they stand.
//
// `quote` returns the word untouched when this is false, so an ordinary
// command line comes back readable.
//
// ```novo
// use shlexquote
//
// fn main() [io]
//     println("${shlexquote.needs_quoting("my files")}")
//     println("${shlexquote.needs_quoting("/tmp/a.txt")}")
// ```
pub fn needs_quoting(word: Str) -> Bool []
    let n = str.len(word)
    if n == 0
        return true
    for i in 0..n
        if not is_safe(str.byte_at_or(word, i, 0))
            return true
    false

// Whether a word would be read as an option by the program it is
// passed to.
//
// True when it begins with `-`.  Quoting does not change this and
// cannot: `-rf` is one word either way, and the program on the other
// end is the one that decides what a leading dash means.
//
// A caller that has a file name from somewhere else prefixes `./` or
// puts `--` in front of the operands, which is what the answer is for.
//
// ```novo
// use shlexquote
//
// fn main() [io]
//     println("${shlexquote.is_option_like("-rf")}")
//     println("${shlexquote.is_option_like("./-rf")}")
// ```
pub fn is_option_like(word: Str) -> Bool []
    str.starts_with(word, "-")

// The offset of the first NUL byte in a word, or `-1`.
//
// The one thing `quote` refuses, offered on its own so a caller can
// check a string it is about to build a command line out of.
//
// ```novo
// use shlexquote
//
// fn main() [io]
//     println("${shlexquote.first_nul("plain text")}")
// ```
pub fn first_nul(word: Str) -> Int []
    for i in 0..str.len(word)
        if str.byte_at_or(word, i, 1) == 0
            return i
    0 - 1

// Whether a byte means nothing to a shell anywhere in a word: an ASCII
// letter, a digit, or one of `@%+=:,./-_`.
fn is_safe(b: Int) -> Bool
    if b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b >= '0' and b <= '9'
        return true
    b == '@' or b == '%' or b == '+' or b == '=' or b == ':' or b == ',' or b == '.' or b == '/' or b == '-' or b == '_'
