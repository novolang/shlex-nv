// shlexbash_tests.nv — the forms that are refused, and why refusing is
// the only honest answer.

use std.test
use shlexbash
use shlexsplit
use shlexerror

@test
fn test_each_named_form_is_found_where_it_starts() [io]
    test.case("ANSI-C quoting")
    match shlexbash.first_form("echo $'a\\tb'")
        Some(found) =>
            test.assert(shlexbash.form_code(found.form) == "ansi_c_quote")
            test.assert(found.at == 5)
        None        => test.fail("$'...' is a bash-only form")

    test.case("locale translation")
    match shlexbash.first_form("echo $\"hello\"")
        Some(found) => test.assert(shlexbash.form_code(found.form) == "locale_quote")
        None        => test.fail("$\"...\" is a bash-only form")

    test.case("process substitution, either direction")
    match shlexbash.first_form("diff <(sort a) <(sort b)")
        Some(found) =>
            test.assert(shlexbash.form_code(found.form) == "process_sub")
            test.assert(found.at == 5)
        None        => test.fail("<(...) is a bash-only form")

    test.case("brace expansion")
    match shlexbash.first_form("touch a{1,2}.txt")
        Some(found) => test.assert(shlexbash.form_code(found.form) == "brace_expansion")
        None        => test.fail("{a,b} is a bash-only form")

    test.case("the compound commands")
    match shlexbash.first_form("[[ -f a ]]")
        Some(found) => test.assert(shlexbash.form_code(found.form) == "compound_command")
        None        => test.fail("[[ ]] is a bash-only form")

    test.case("and an extended glob")
    match shlexbash.first_form("ls !(a b)")
        Some(found) => test.assert(shlexbash.form_code(found.form) == "ext_glob")
        None        => test.fail("!(...) is a bash-only form")

@test
fn test_an_ordinary_line_holds_none_of_them() [io]
    test.case("a plain command")
    test.assert(not shlexbash.is_bash_only("cp -r 'my files' /tmp"))
    match shlexbash.first_form("cp -r 'my files' /tmp")
        Some(_) => test.fail("nothing here is bash-only")
        None    => test.assert(true)

    test.case("a dollar sign on its own is an ordinary character in POSIX")
    test.assert(not shlexbash.is_bash_only("echo \$PATH"))

    test.case("and so is a brace with nothing to expand")
    test.assert(not shlexbash.is_bash_only("echo {}"))

@test
fn test_the_splitter_refuses_rather_than_answering_the_wrong_split() [io]
    // Bash reads `$'a b'` as `a b`, and POSIX as `$a b`.  A splitter
    // that answered either would have the program run a command
    // nobody wrote.
    test.case("the line is refused, naming the form and the offset")
    match shlexsplit.split("echo $'a b'")
        Ok(_)      => test.fail("this line means two different things")
        Err(fault) =>
            test.assert(shlexerror.code(fault) == "bash_only")
            test.assert(shlexerror.offset(fault) == 5)

    test.case("and it is not an unfinished line: reading more would not help")
    match shlexsplit.split("echo $'a b'")
        Ok(_)      => test.fail("this line means two different things")
        Err(fault) => test.assert(not shlexerror.is_incomplete(fault))

    test.case("so `is_complete` is true and splitting still fails")
    test.assert(shlexsplit.is_complete("echo $'a b'"))

@test
fn test_every_form_can_say_what_the_two_readings_disagree_about() [io]
    // The message worth showing a caller is not "unsupported": it is
    // that bash and POSIX would split the line differently.
    test.case("each form has a name and a disagreement")
    test.assert(str.len(shlexbash.form_name(ShlexAnsiCQuote)) > 0)
    test.assert(str.len(shlexbash.form_disagreement(ShlexAnsiCQuote)) > 0)
    test.assert(str.len(shlexbash.form_name(ShlexLocaleQuote)) > 0)
    test.assert(str.len(shlexbash.form_disagreement(ShlexProcessSub)) > 0)
    test.assert(str.len(shlexbash.form_name(ShlexBraceExpansion)) > 0)
    test.assert(str.len(shlexbash.form_name(ShlexCompoundCommand)) > 0)
    test.assert(str.len(shlexbash.form_disagreement(ShlexExtGlob)) > 0)

    test.case("and the codes are distinct, so a metric can count them apart")
    test.assert(shlexbash.form_code(ShlexAnsiCQuote) != shlexbash.form_code(ShlexLocaleQuote))

@test
fn test_every_form_has_all_three_texts() [io]
    let forms = [ShlexAnsiCQuote,
        ShlexLocaleQuote,
        ShlexProcessSub,
        ShlexBraceExpansion,
        ShlexCompoundCommand,
        ShlexExtGlob]
    test.case("a name, a code and a disagreement for each of the six")
    for form in forms
        test.assert(str.len(shlexbash.form_name(form)) > 0)
        test.assert(str.len(shlexbash.form_code(form)) > 0)
        test.assert(str.len(shlexbash.form_disagreement(form)) > 0)
    test.assert(shlexbash.is_bash_only("echo $'a'"))

@test
fn test_a_compound_command_is_found_only_where_it_begins_a_word() [io]
    test.case("an arithmetic command")
    match shlexbash.first_form("(( i++ ))")
        Some(found) =>
            test.assert(shlexbash.form_code(found.form) == "compound_command")
            test.assert(found.at == 0)
        None        => test.fail("(( )) is a bash-only form")

    test.case("a bracket expression is a glob, not a conditional command")
    test.assert(not shlexbash.is_bash_only("grep [[:digit:]] f"))

    test.case("and `[[` inside a word is text")
    test.assert(not shlexbash.is_bash_only("echo a[[ b"))

@test
fn test_a_brace_pair_is_an_expansion_only_when_it_holds_alternatives() [io]
    test.case("a nested pair")
    match shlexbash.first_form("echo {a,{b,c}}")
        Some(found) => test.assert(found.at == 5)
        None        => test.fail("{a,{b,c}} is brace expansion")

    test.case("a sequence")
    test.assert(shlexbash.is_bash_only("echo {1..9}"))

    test.case("a blank ends the word before the brace closes")
    test.assert(not shlexbash.is_bash_only("echo {a b,c}"))

    test.case("an escaped or quoted comma is text")
    test.assert(not shlexbash.is_bash_only("echo {a\\,b}"))
    test.assert(not shlexbash.is_bash_only("echo {'a,b'}"))
    test.assert(not shlexbash.is_bash_only("echo {\"a,b\"}"))

    test.case("an unclosed brace is text")
    test.assert(not shlexbash.is_bash_only("echo {a,b"))

    test.case("and a parameter expansion is not a brace expansion")
    test.assert(not shlexbash.is_bash_only("echo \${a,b}"))

@test
fn test_a_form_inside_quotes_or_a_comment_is_text() [io]
    test.case("inside double quotes, past an escaped quote")
    test.assert(not shlexbash.is_bash_only("echo \"a\\\"<(b)\""))

    test.case("after an unclosed double quote nothing is outside quotes")
    test.assert(not shlexbash.is_bash_only("echo \"a <(b)"))

    test.case("behind a backslash")
    test.assert(not shlexbash.is_bash_only("echo \\<(b)"))

    test.case("and in a comment, when comments are on")
    let commented = shlexsplit.with_comments(shlexsplit.options())
    match shlexsplit.split_with("ls # $'x'\necho", commented)
        Ok(argv)   => test.assert(list.len(argv) == 2)
        Err(fault) => test.fail(fault.message())
